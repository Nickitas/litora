{
  "name": "litora",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "env:init": "node scripts/setup.mjs",
    "up": "pnpm env:init && docker compose --env-file .env.local -f infra/compose.yaml --profile app up -d --build",
    "down": "docker compose --env-file .env.local -f infra/compose.yaml --profile app down",
    "logs": "docker compose --env-file .env.local -f infra/compose.yaml --profile app logs -f",
    "build:cli": "cd apps/lito-cli && go build -o bin/lito ./cmd/lito",
    "dev:api": "pnpm --filter litora-api start:dev",
    "dev:worker": "pnpm --filter litora-api worker",
    "dev:web": "pnpm --filter litora-web dev",
    "test:api": "pnpm --filter litora-api test",
    "test:api:db": "pnpm --filter litora-api test:db",
    "test:integration": "node scripts/integration-test.mjs",
    "infra:up": "docker compose --env-file .env.local -f infra/compose.yaml up -d",
    "infra:down": "docker compose --env-file .env.local -f infra/compose.yaml down",
    "infra:logs": "docker compose --env-file .env.local -f infra/compose.yaml logs -f",
    "build:web": "pnpm --filter litora-web build",
    "build:api": "pnpm --filter litora-api build",
    "lint": "pnpm --filter litora-web lint",
    "check:workspace": "node scripts/check-workspace.mjs",
    "test:web": "pnpm --filter litora-web test:verify",
    "test:bundle": "pnpm --filter litora-web analyze:bundle --check",
    "verify": "pnpm check:workspace && pnpm typecheck && pnpm lint && pnpm test:web && pnpm test:api && pnpm test:cli && pnpm build:api && pnpm build:web && pnpm test:bundle",
    "typecheck": "pnpm --filter @litora/api-client typecheck && pnpm --filter @litora/contracts typecheck && pnpm --filter litora-api typecheck && pnpm --filter litora-web typecheck",
    "test:cli": "cd apps/lito-cli && go test ./..."
  }
}
