# Пример, не готовые учётные данные. Файл сервера: /etc/litora/production.env, mode 0600.
LITORA_DOMAIN=litora.example.org
ACME_EMAIL=operator@example.org
# Реальные публичные IP команды/выход VPN, разделённые пробелами. Не 0.0.0.0/0.
LITORA_ALLOWED_CIDRS='203.0.113.10/32'

# Multi-arch index digests проверены 25.09.2026 для linux/amd64 и linux/arm64.
# Перед выпуском перепроверить у registry и обновить по процедуре deployment.md.
POSTGRES_IMAGE=postgres:17.10-alpine3.24@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
# Локальная сборка: уникальный проверенный SHA; не переиспользовать тег.
API_IMAGE=litora-api:REPLACE_WITH_RELEASE_SHA
WEB_IMAGE=litora-web:REPLACE_WITH_RELEASE_SHA

# Два разных случайных hex-пароля (openssl rand -hex 32).
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Базовый endpoint сервиса, без имени bucket и без хвостового пути.
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
S3_ACCESS_KEY=REPLACE_WITH_SCOPED_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SCOPED_SECRET_KEY
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false
JOB_TIMEOUT_MS=300000
