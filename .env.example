POSTGRES_DB=litora
POSTGRES_USER=litora
POSTGRES_PASSWORD=litora_local_password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://litora:litora_local_password@localhost:55432/litora

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=litora
S3_ACCESS_KEY=litora
S3_SECRET_KEY=litora_local_password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
WEB_PORT=5173
API_PORT=3000
COOKIE_SECURE=false
# Пусто: не доверяем X-Forwarded-For. В production — только адрес proxy, не true.
TRUSTED_PROXY_CIDRS=
JOB_TIMEOUT_MS=300000
